         <dc:creator>
            <rdf:Seq>
               <rdf:li>Wang, Mingyu; Wang, Zijian; Talbot, John; Gerdes, J. Christian; Schwager, Mac</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Final version submitted to IEEE Transactions on Robotics December 22, 2020 13:28:12 Pacific Time</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Game Theoretic Planning for Self-Driving Cars in Multi-Vehicle Competitive Scenarios</rdf:li>
            </rdf:Alt>
